# Copy to .env.sandbox. Local sandbox only; never expose these example secrets.
NODE_ENV=production
DEPLOYMENT_MODE=sandbox
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
DATABASE_URL=mysql://vedic_sandbox:sandbox-db-password@mysql:3306/vedic_sandbox
MYSQL_ROOT_PASSWORD=sandbox-root-password
MYSQL_PASSWORD=sandbox-db-password

AUTH_PROVIDER=sandbox
VITE_APP_ID=vedic-karma-sandbox
OWNER_OPEN_ID=sandbox-owner
OWNER_NAME=Sandbox Owner
JWT_SECRET=sandbox-jwt-secret-change-me-32-characters
SANDBOX_AUTH_TOKEN=sandbox-login-token-change-me-32-characters
SCHEDULED_TASK_SECRET=sandbox-scheduler-secret-change-32-chars
PRODUCTION_SMOKE_SECRET=sandbox-smoke-secret-change-me-32-chars

CALCULATION_ENGINE_LICENSE=AGPL-3.0-or-later
VITE_SOURCE_CODE_URL=https://github.com/StarLordKarma/VedicKarmaDesign
SWE_EPHE_PATH=
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

MINIO_ROOT_USER=vedic-sandbox
MINIO_ROOT_PASSWORD=sandbox-minio-password
STORAGE_PROVIDER=s3
S3_BUCKET=vedic-sandbox
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=vedic-sandbox
AWS_SECRET_ACCESS_KEY=sandbox-minio-password

NOWPAYMENTS_API_KEY=sandbox-api-key
NOWPAYMENTS_IPN_SECRET=sandbox-ipn-secret
NOWPAYMENTS_BASE_URL=http://mock-services:4010/v1
RESEND_API_KEY=sandbox-resend-key
RESEND_FROM_EMAIL=Sandbox <no-reply@sandbox.invalid>
RESEND_BASE_URL=http://mock-services:4010/emails
OWNER_ALERT_EMAIL=owner@sandbox.invalid
LLM_BASE_URL=http://mock-services:4010/v1
LLM_API_KEY=sandbox-llm-key
MAPS_BASE_URL=http://mock-services:4010
GOOGLE_MAPS_API_KEY=sandbox-maps-key
MOCK_PUBLIC_URL=http://127.0.0.1:4010
APP_INTERNAL_URL=http://app:3000
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_PAYMENT_TESTS=false
