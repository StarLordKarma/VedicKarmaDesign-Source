# Copy to .env.production on the server. Never commit the filled file.
NODE_ENV=production
DEPLOYMENT_MODE=independent
PORT=3000
TRUST_PROXY_HOPS=1
SITE_DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com

# Free network deployment: exact deployed corresponding source must be public.
CALCULATION_ENGINE_LICENSE=AGPL-3.0-or-later
VITE_SOURCE_CODE_URL=https://github.com/your-account/your-public-source-mirror
SWE_EPHE_PATH=
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

DATABASE_URL=mysql://vedic_app:replace@database.example:3306/vedic_production
JWT_SECRET=replace-with-at-least-32-random-characters
SCHEDULED_TASK_SECRET=replace-with-another-32-character-secret
PRODUCTION_SMOKE_SECRET=replace-with-a-third-32-character-secret
OWNER_OPEN_ID=production-owner
OWNER_NAME=Owner

AUTH_PROVIDER=oidc
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_OWNER_SUBJECT=

STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.example.com
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_BASE_URL=https://api.resend.com/emails
OWNER_ALERT_EMAIL=

GOOGLE_MAPS_API_KEY=
MAPS_BASE_URL=https://maps.googleapis.com
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

VITE_APP_TITLE=Vedic Karma Design
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Must remain false except during a controlled staging acceptance.
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_PAYMENT_TESTS=false
PRODUCTION_SEED_CONFIRM=

# Host-side backup command. Prefer a read-only backup identity.
BACKUP_DIR=/opt/vedic-karma/backups
DB_HOST=
DB_PORT=3306
DB_NAME=vedic_production
DB_USER=vedic_backup
DB_PASSWORD=
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=
