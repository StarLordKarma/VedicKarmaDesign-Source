# Copy to .env.production on the server. Never commit the filled file.
NODE_ENV=production
DEPLOYMENT_MODE=independent
PORT=3000
TRUST_PROXY_HOPS=1
SITE_DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com

# Free network deployment: exact deployed corresponding source must be public.
CALCULATION_ENGINE_LICENSE=AGPL-3.0-or-later
VITE_SOURCE_CODE_URL=https://github.com/StarLordKarma/VedicKarmaDesign-Source
SWE_EPHE_PATH=
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Budget profile: the `database` host is the MySQL service in docker-compose.prod.yml.
# Generate MYSQL_* passwords independently; URL-encode MYSQL_APP_PASSWORD here.
MYSQL_DATABASE=vedic_production
MYSQL_APP_USER=vedic_app
MYSQL_APP_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-root-password
DATABASE_URL=mysql://vedic_app:replace-with-random-database-password@database:3306/vedic_production
JWT_SECRET=replace-with-at-least-32-random-characters
SCHEDULED_TASK_SECRET=replace-with-another-32-character-secret
PRODUCTION_SMOKE_SECRET=replace-with-a-third-32-character-secret
OWNER_OPEN_ID=production-owner
OWNER_NAME=Owner

AUTH_PROVIDER=oidc
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_OWNER_SUBJECT=

STORAGE_PROVIDER=s3
S3_BUCKET=
# Cloudflare R2: Dashboard → R2 → Overview gives account ID; create a token scoped
# to this bucket only. Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_BASE_URL=https://api.resend.com/emails
OWNER_ALERT_EMAIL=

# Google Cloud → APIs & Services → Credentials. Restrict server key by production
# server IP and to Geocoding API + Time Zone API; set low daily quotas.
GOOGLE_MAPS_API_KEY=
MAPS_BASE_URL=https://maps.googleapis.com
# Groq is OpenAI-compatible and has a free capped tier. Gemini/OpenRouter may be
# used only after verifying model/privacy terms; LLM never supplies chart facts.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

VITE_APP_TITLE=Vedic Karma Design
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Must remain false except during a controlled staging acceptance.
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_PAYMENT_TESTS=false
PRODUCTION_SEED_CONFIRM=

# Host-side backup command. Prefer a read-only backup identity.
BACKUP_DIR=/opt/vedic-karma/backups
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vedic_production
DB_USER=root
DB_PASSWORD=replace-with-different-random-root-password
BACKUP_RETENTION_DAYS=30
BACKUP_S3_URI=s3://replace-with-private-backup-bucket/mysql
# AWS CLI endpoint used by backup-production.sh for an R2-compatible bucket.
AWS_ENDPOINT_URL_S3=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Used by scripts/backup-s3.sh. Keep backup bucket/account separate if possible.
# rclone remote names are configured separately in root-only rclone.conf.
RCLONE_PDF_REMOTE=r2:replace-with-private-pdf-bucket
RCLONE_BACKUP_REMOTE=b2:replace-with-private-backup-bucket/pdf
