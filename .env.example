# Local development template. Copy to .env and replace placeholders.
# Never commit real secrets or customer data.
NODE_ENV=development
DEPLOYMENT_MODE=managed
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://root:password@127.0.0.1:3306/vedic
JWT_SECRET=replace-with-at-least-32-random-characters
OWNER_OPEN_ID=replace-with-owner-id
OWNER_NAME=Owner

# Calculation engine: local Swiss Ephemeris binding plus project-owned Jyotish rules.
# Public network use under this free mode requires AGPL compliance and source access.
CALCULATION_ENGINE_LICENSE=AGPL-3.0-or-later
SWE_EPHE_PATH=
VITE_SOURCE_CODE_URL=https://github.com/your-account/your-public-source-repository

# Independent authentication (production: AUTH_PROVIDER=oidc).
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_OWNER_SUBJECT=

# Private S3-compatible object storage.
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI-compatible narrative provider, maps and email.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
GOOGLE_MAPS_API_KEY=
# Test/sandbox override only. Production normally uses the Google endpoint.
MAPS_BASE_URL=https://maps.googleapis.com
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Test/sandbox override only. Production normally uses Resend directly.
RESEND_BASE_URL=https://api.resend.com/emails
OWNER_ALERT_EMAIL=

# Crypto checkout and signed callbacks.
PAYMENT_PROVIDER=direct
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Test/sandbox override only. Never point production at an untrusted endpoint.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# Alternative crypto providers. Configure only the selected PAYMENT_PROVIDER.
HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_API_KEY=
HELEKET_BASE_URL=https://api.heleket.com
PAYCRYPTO_API_KEY=
# Random 32+ character callback token, stored only in secret storage.
PAYCRYPTO_WEBHOOK_TOKEN=
# JSON object of public receiving addresses, for example {"btc":{"address":"..."}}.
PAYCRYPTO_COINS_JSON=
PAYCRYPTO_BASE_URL=https://paycrypto.global/api

# Local sandbox login only. AUTH_PROVIDER=sandbox is rejected outside sandbox mode.
SANDBOX_AUTH_TOKEN=

# Scheduled operations and controlled production smoke tests.
SCHEDULED_TASK_SECRET=replace-with-a-different-32-character-secret
PRODUCTION_SMOKE_SECRET=replace-with-another-32-character-secret
PRODUCTION_SMOKE_BASE_URL=
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_PAYMENT_TESTS=false

# Seed safety. Keep false outside the explicit staging seed command. Remote
# staging databases additionally require ALLOW_REMOTE_STAGING_SEED=true.
STAGING_SEED_CONFIRM=false
ALLOW_REMOTE_STAGING_SEED=false

# Public branding and optional consent-gated analytics.
VITE_APP_TITLE=Vedic Karma Design
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
REPORT_FONT_PATH=
TRUST_PROXY_HOPS=1

# Legacy Manus adapters; leave empty for an independent deployment.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Direct noncustodial multi-network USDT checkout.
# Set PAYMENT_PROVIDER=direct to select it. Never put a private key here.
DIRECT_WALLET_ADDRESS=0xBedc9b4709b5c9759aeCDcD542BF91c9C2aD7340
DIRECT_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# Optional explicit commercial exchange rates: 1 EUR/GBP = this many USDT.
# Blank uses a fresh public Coinbase rate, frozen when the invoice is created.
DIRECT_EUR_USDT_RATE=
DIRECT_GBP_USDT_RATE=
# False keeps owner review; true sends reports that pass automatic quality checks.
REPORT_AUTO_DELIVERY=true

# Additional direct checkout networks. Blank disables that network for new invoices.
DIRECT_POLYGON_RPC_URL=https://polygon.drpc.org
DIRECT_BNB_RPC_URL=https://bsc-dataseed.bnbchain.org
DIRECT_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
DIRECT_TRON_API_URL=https://api.trongrid.io
DIRECT_TRON_WALLET_ADDRESS=TLjWhpJwVAmYYv55CVYDVppenstMXvX3si
# Set via secret manager if the TronGrid plan requires authentication.
TRONGRID_API_KEY=

# Direct payments automatically generate reports; false keeps the existing Report Studio setting.
DIRECT_AUTO_PROCESS=true
