FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ARG VITE_SOURCE_CODE_URL
ENV NODE_ENV=production \
    VITE_SOURCE_CODE_URL=$VITE_SOURCE_CODE_URL \
    REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

RUN apt-get update \
  && apt-get install -y --no-install-recommends fonts-dejavu-core ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && groupadd --system app \
  && useradd --system --gid app --home-dir /app app

COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN corepack pnpm install --frozen-lockfile
COPY . .
RUN corepack pnpm run build \
  && test -s /app/dist/index.js \
  && corepack pnpm prune --prod

RUN chown -R app:app /app
USER app

EXPOSE 3000
CMD ["node", "/app/dist/index.js"]

# Northflank-specific single-stage image. This avoids a platform image-export
# issue observed with the final stage of the portable multi-stage Dockerfile.
