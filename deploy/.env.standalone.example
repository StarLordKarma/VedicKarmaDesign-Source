# Copy to .env.standalone locally or inject through a secret manager.
# Never commit the filled file.
NODE_ENV=production
DEPLOYMENT_MODE=independent
PORT=3000
TRUST_PROXY_HOPS=1
SITE_DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com
# Required by the free Swiss Ephemeris path. Public deployments must provide
# the corresponding application source under AGPL-3.0-or-later.
CALCULATION_ENGINE_LICENSE=AGPL-3.0-or-later
VITE_SOURCE_CODE_URL=https://github.com/your-account/your-public-source-repository
# Optional Swiss Ephemeris .se1 directory. Without it the deterministic Moshier
# fallback is used and recorded as `moseph` in each calculation snapshot.
SWE_EPHE_PATH=
DATABASE_URL=mysql://user:password@db.example.com:3306/vedic
JWT_SECRET=replace-with-a-high-entropy-random-secret
SCHEDULED_TASK_SECRET=replace-with-a-separate-scheduler-secret
PRODUCTION_SMOKE_SECRET=replace-with-a-separate-smoke-test-secret
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
OWNER_OPEN_ID=replace-with-owner-id
OWNER_NAME=Owner
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_OWNER_SUBJECT=
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NOTIFICATION_PROVIDER=resend
OWNER_ALERT_EMAIL=
GOOGLE_MAPS_API_KEY=
# OpenAI-compatible API base including /v1; use a provider supporting the selected model.
LLM_BASE_URL=
LLM_API_KEY=
VITE_APP_TITLE=Vedic Astrology Readings
VITE_APP_LOGO=https://example.com/logo.png
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Keep these Manus values only when using the corresponding Manus adapters.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
