# Copy to deploy/.env.staging. These values are local-only examples; rotate them
# before any shared or internet-accessible staging deployment.
NODE_ENV=production
# `staging` permits local HTTP and empty provider credentials. Production must
# use `independent`, which activates fail-closed validation.
DEPLOYMENT_MODE=staging
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
TRUST_PROXY_HOPS=0

MYSQL_ROOT_PASSWORD=replace-local-root-password
MYSQL_PASSWORD=replace-local-app-password
DATABASE_URL=mysql://vedic_staging:replace-local-app-password@mysql:3306/vedic_staging

MINIO_ROOT_USER=vedic-staging
MINIO_ROOT_PASSWORD=replace-local-minio-password
STORAGE_PROVIDER=s3
S3_BUCKET=vedic-staging
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=vedic-staging
AWS_SECRET_ACCESS_KEY=replace-local-minio-password

CALCULATION_ENGINE_LICENSE=AGPL-3.0-or-later
VITE_SOURCE_CODE_URL=https://github.com/StarLordKarma/VedicKarmaDesign
SWE_EPHE_PATH=
REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

JWT_SECRET=replace-with-at-least-32-staging-characters
SCHEDULED_TASK_SECRET=replace-with-another-32-staging-characters
PRODUCTION_SMOKE_SECRET=replace-with-a-third-32-staging-characters
OWNER_OPEN_ID=staging-owner
OWNER_NAME=Staging Owner
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://replace-with-test-identity-provider.example
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_OWNER_SUBJECT=

GOOGLE_MAPS_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_ALERT_EMAIL=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_PAYMENT_TESTS=false
