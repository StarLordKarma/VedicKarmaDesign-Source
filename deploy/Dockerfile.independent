FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ARG VITE_SOURCE_CODE_URL
ENV NODE_ENV=production \
    VITE_SOURCE_CODE_URL=$VITE_SOURCE_CODE_URL \
    REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

RUN apt-get update \
  && apt-get install -y --no-install-recommends fonts-dejavu-core ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && groupadd --system app \
  && useradd --system --gid app --home-dir /app app
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN corepack pnpm install --frozen-lockfile
COPY . .
RUN corepack pnpm run build \
  && test -s /app/dist/index.js \
  && corepack pnpm prune --prod

RUN chown -R app:app /app
USER app

EXPOSE 3000
CMD ["node", "/app/dist/index.js"]

# Build from repository root:
# docker build -f deploy/Dockerfile.independent -t vedic-astrology-booking .
# docker run --env-file .env.standalone -p 3000:3000 vedic-astrology-booking
# Provide secrets through an external secret manager or env file; never commit them.
# Use host/platform scheduling for cleanup and SLA callbacks instead of in-container cron.
# The single-stage layout is intentional: it also works around a final-stage export
# issue observed on the current Northflank builder while retaining a portable image.

# Compose migration and seed jobs need the development CLIs removed from the
# production runtime above. Keep this compatibility stage after runtime so
# Northflank can continue targeting `runtime` unchanged.
FROM runtime AS build
USER root
RUN corepack pnpm install --frozen-lockfile
USER app

# Preserve the production runtime as the default output for ordinary builds.
FROM runtime AS final
