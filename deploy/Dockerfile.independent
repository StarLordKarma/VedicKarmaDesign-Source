FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN corepack pnpm install --frozen-lockfile
COPY . .
RUN corepack pnpm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    REPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
RUN apt-get update \
  && apt-get install -y --no-install-recommends fonts-dejavu-core ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && groupadd --system app \
  && useradd --system --gid app --home-dir /app app
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN corepack pnpm install --prod --frozen-lockfile
COPY --from=build /app/dist ./dist
USER app

EXPOSE 3000
CMD ["node", "dist/index.js"]

# Build from repository root:
# docker build -f deploy/Dockerfile.independent -t vedic-astrology-booking .
# docker run --env-file .env.standalone -p 3000:3000 vedic-astrology-booking
# Provide secrets through an external secret manager or env file; never commit them.
# Use host/platform scheduling for cleanup and SLA callbacks instead of in-container cron.
