{
  "name": "vedic-astrology-booking",
  "version": "1.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts server/migrate.ts --platform=node --packages=external --bundle --format=esm --define:process.env.NODE_ENV='\"production\"' --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "deploy:check": "pnpm lint && pnpm check && pnpm test && pnpm build",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke:production": "node scripts/production-smoke-test.mjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DEPLOYMENT_MODE=independent drizzle-kit migrate",
    "db:migrate:runtime": "NODE_ENV=production node dist/migrate.js",
    "db:seed": "tsx scripts/seed-staging.ts",
    "db:seed:staging": "STAGING_SEED_CONFIRM=true tsx scripts/seed-staging.ts",
    "db:seed:prod": "DEPLOYMENT_MODE=independent tsx scripts/seed-production.ts",
    "backup:prod": "sh scripts/backup-production.sh",
    "backup:db": "sh scripts/backup-db.sh",
    "backup:s3": "sh scripts/backup-s3.sh",
    "restore:db": "sh scripts/restore-db.sh",
    "deploy:staging": "docker compose --env-file deploy/.env.staging -f deploy/compose.staging.yml up -d --build",
    "deploy:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "deploy:server": "sh scripts/deploy.sh",
    "sandbox:up": "docker compose --env-file .env.sandbox -f docker-compose.sandbox.yml up -d --build",
    "sandbox:down": "docker compose --env-file .env.sandbox -f docker-compose.sandbox.yml down",
    "db:migrate:sandbox": "docker compose --env-file .env.sandbox -f docker-compose.sandbox.yml --profile tools run --rm migrate",
    "db:seed:sandbox": "SANDBOX_SEED_CONFIRM=true tsx scripts/seed-sandbox.ts",
    "sandbox:seed": "docker compose --env-file .env.sandbox -f docker-compose.sandbox.yml --profile tools run --rm seed",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
