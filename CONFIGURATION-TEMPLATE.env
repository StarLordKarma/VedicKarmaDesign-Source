# Vedic Astrology Booking — safe configuration template
# Copy this file to .env locally, or configure the same names in a platform secret manager.
# NEVER commit real values. Keep server-only values out of VITE_* variables.

# Runtime
NODE_ENV=development
PORT=3000

# Database — server-only, MySQL/TiDB-compatible URL with SSL in production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Session and owner authorization — server-only
JWT_SECRET=replace-with-a-long-random-session-secret
OWNER_OPEN_ID=replace-with-the-owner-oauth-open-id
OWNER_NAME=Account owner

# Manus OAuth
VITE_APP_ID=replace-with-oauth-application-id
OAUTH_SERVER_URL=https://oauth-provider.example.com
VITE_OAUTH_PORTAL_URL=https://oauth-portal.example.com

# Manus built-in Forge APIs and storage helpers
BUILT_IN_FORGE_API_URL=https://forge-api.example.com
BUILT_IN_FORGE_API_KEY=replace-with-server-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://forge-api.example.com
VITE_FRONTEND_FORGE_API_KEY=replace-with-frontend-scoped-forge-key

# Crypto checkout — server-only
NOWPAYMENTS_API_KEY=replace-with-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-nowpayments-ipn-secret

# Email delivery — server-only key; sender must be verified with the provider
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Astrology Reports <reports@example.com>

# Swiss Ephemeris — optional local ephemeris data path; blank uses fallback mode
SWE_EPHE_PATH=

# Production smoke tests — never use real payment flow without an explicit test marker
PRODUCTION_SMOKE_BASE_URL=https://your-production-domain.example
PRODUCTION_SMOKE_RUN=false
RUN_LIVE_PAYMENT_TESTS=false

# Test/runtime flags; normally leave unset
VITEST=
